{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommits",
    ":dependencyDashboard",
    "helpers:pinGitHubActionDigests"
  ],
  "timezone": "Asia/Seoul",
  "schedule": [
    "before 9am on monday"
  ],
  "labels": [
    "dependencies"
  ],
  "rangeStrategy": "bump",
  "prConcurrentLimit": 3,
  "prHourlyLimit": 2,
  "minimumReleaseAge": "3 days",
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "enabled": true,
    "schedule": [
      "at any time"
    ]
  },
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "before 9am on the first day of the month"
    ]
  },
  "nodenv": {
    "enabled": false
  },
  "packageRules": [
    {
      "description": "Non-major updates: one weekly PR, auto-merged once CI is green",
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "digest"
      ],
      "groupName": "non-major dependencies",
      "automerge": true
    },
    {
      "description": "GitHub Actions: group, automerge non-major",
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "github actions",
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "digest"
      ],
      "automerge": true
    },
    {
      "description": "Major updates: listed on the Dependency Dashboard; a PR is opened only after ticking its checkbox",
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false,
      "dependencyDashboardApproval": true
    },
    {
      "description": "typescript 7 is blocked until typescript-eslint supports TS >= 7.1 (typescript-eslint/typescript-eslint#10940); checked 2026-10-07 against typescript-eslint 8.71.1 (peer typescript <6.1.0). Also needs tsconfig work: baseUrl removed, side-effect CSS imports are errors (TS2882)",
      "matchManagers": [
        "npm"
      ],
      "matchPackageNames": [
        "typescript"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "enabled": false
    },
    {
      "description": "eslint 10 is blocked by eslint-plugin-react (7.37.5 peer eslint <= ^9.7, no eslint 10 release yet); checked 2026-10-07. typescript-eslint 8.71.1 and eslint-plugin-react-hooks 7.1.1 already allow eslint 10",
      "matchManagers": [
        "npm"
      ],
      "matchPackageNames": [
        "eslint",
        "@eslint/js"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "enabled": false
    },
    {
      "description": "Rust toolchain pin (rust-toolchain.toml): manual, one PR per release",
      "matchDepNames": [
        "rust-toolchain"
      ],
      "automerge": false,
      "commitMessageTopic": "Rust toolchain",
      "minimumReleaseAge": "14 days"
    },
    {
      "description": "dav1d-sys is intentionally pinned (was excluded in Dependabot too)",
      "matchManagers": [
        "cargo"
      ],
      "matchPackageNames": [
        "dav1d-sys"
      ],
      "enabled": false
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Bump the pinned channel in rust-toolchain.toml",
      "managerFilePatterns": [
        "/(^|/)rust-toolchain\\.toml$/"
      ],
      "matchStrings": [
        "channel\\s*=\\s*\"(?<currentValue>\\d+\\.\\d+\\.\\d+)\""
      ],
      "depNameTemplate": "rust-toolchain",
      "packageNameTemplate": "rust-lang/rust",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver"
    }
  ]
}
