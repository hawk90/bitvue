docs/_import_v14/

# =============================================================================
# Claude Design sync (/design-sync) — staged converter, build output, machine state.
# .design-sync/config.json, NOTES.md, conventions.md, previews/, overrides/ ARE tracked.
# =============================================================================
.ds-sync/
ds-bundle/
.design-sync/.cache/
.design-sync/learnings/
.design-sync/node_modules
frontend/.design-sync-dist.css

# cargo-mutants output
/mutants.out/
/mutants.out.old/

# =============================================================================
# Local reference clones (never committed)
# =============================================================================
# Shallow clones of third-party sources used to check parsing against the spec/reference decoder:
#   git clone --depth 1 https://github.com/AOMediaCodec/av1-spec.git .refs/av1-spec
#   git clone --depth 1 https://code.videolan.org/videolan/dav1d.git .refs/dav1d
# `git grep` skips them (untracked + ignored); use `grep -rn` / `rg --no-ignore` inside .refs/.
/.refs/
