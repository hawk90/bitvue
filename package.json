{
  "name": "bitvue-workspace",
  "version": "0.11.5",
  "description": "Bitvue workspace - video bitstream analyzer with Electron + React (migrated from Tauri 2026-08-08, see docs/DEVELOPMENT_PHASES.md)",
  "private": true,
  "packageManager": "npm@12.2.1",
  "engines": {
    "node": ">=24.22.1"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24",
      "onFail": "error"
    },
    "packageManager": {
      "name": "npm",
      "version": ">=11.0.0 <13",
      "onFail": "error"
    }
  },
  "scripts": {
    "dev": "cd frontend && npm run dev",
    "build": "cd frontend && npm run build",
    "test": "cd frontend && npm run test",
    "test:ui": "cd frontend && npm run test:ui",
    "test:run": "cd frontend && npm run test:run",
    "test:coverage": "cd frontend && npm run test:coverage",
    "typecheck": "cd frontend && npm run typecheck",
    "preview": "cd frontend && npm run preview",
    "lint": "cd frontend && npm run lint",
    "lint:css": "cd frontend && npm run lint:css",
    "format": "cd frontend && npm run format",
    "format:check": "cd frontend && npm run format:check",
    "electron": "cd bitvue-desktop && npm run electron",
    "clean": "npm run clean:rust && npm run clean:frontend",
    "clean:rust": "cargo clean",
    "clean:frontend": "cd frontend && rm -rf node_modules dist"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/jsdom": "^30.0.0",
    "jsdom": "^30.1.3"
  }
}
